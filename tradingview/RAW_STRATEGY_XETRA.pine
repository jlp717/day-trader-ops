//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// RAW STRATEGY XETRA · versión de prueba (Strategy Tester) sobre la regla de nico66fx
// Entra en la primera vela de 5 min de NY, stop en su mínimo, objetivo a N×R,
// cierre forzado antes del final de sesión. Comisión configurable por lado.
// Esto es para MEDIR, no para operar: los resultados históricos no garantizan nada.
// ─────────────────────────────────────────────────────────────────────────────
strategy('RAW Strategy US · nico66fx', overlay = true, initial_capital = 10000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.15,
     process_orders_on_close = true, calc_on_every_tick = false,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

const string TZ = 'Europe/Berlin'

riesgo_p  = input.float(1.0, 'Riesgo por operacion (%)', minval = 0.05, maxval = 5, step = 0.05)
target_r  = input.float(2.0, 'Objetivo (R)', minval = 0.5, maxval = 10, step = 0.5)
buf_pct   = input.float(0.05, 'Buffer del stop (%)', minval = 0, maxval = 2, step = 0.05)
min_risk  = input.float(0.20, 'Stop minimo (%)', minval = 0.05, maxval = 2, step = 0.05)
usar_tend = input.bool(true, 'Solo largos con el diario sobre SMA200')
hora_fin  = input.int(1725, 'Cierre forzado (HHMM Madrid)', minval = 1000, maxval = 1800)

int  tf_sec = timeframe.in_seconds()
bool low_tf = tf_sec <= 300
bool htf    = not low_tf and tf_sec <= 86400

_k(float x) =>
    var float a = na
    a := na(a) ? x : a + (x - a) * (4.0 / 26.0)
    a

[m5T, m5H, m5L, m5C, m5E] = request.security(syminfo.tickerid, '5', [time, high, low, close, _k(close)], lookahead = barmerge.lookahead_off)
[aT, aH, aL, aC, aE] = request.security_lower_tf(syminfo.tickerid, low_tf ? timeframe.period : '5', [time, high, low, close, _k(close)])

dClose  = request.security(syminfo.tickerid, 'D', close[1], lookahead = barmerge.lookahead_off)
dSma    = request.security(syminfo.tickerid, 'D', ta.sma(close, 200)[1], lookahead = barmerge.lookahead_off)
tend_ok = not usar_tend or na(dSma) or dClose > dSma

openTime(int t) => timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 9, 0)
keyOf(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

int c1   = openTime(time)
int c2   = openTime(time_close)
int tBar = c1 >= time and c1 < time_close ? c1 : c2 >= time and c2 < time_close ? c2 : na
int tOpen  = low_tf ? c1 : tBar
int tOpen5 = na(tOpen) ? na : tOpen + 5 * 60 * 1000
int dayKey = na(tOpen) ? 0 : keyOf(tOpen)

bool  found = false
float sH = na
float sL = na
float sC = na
float sE = na
if low_tf
    if barstate.isconfirmed and not na(m5E) and m5T == tOpen and time_close == tOpen5
        found := true
        sH := m5H
        sL := m5L
        sC := m5C
        sE := m5E
else if htf and not na(tOpen)
    n = array.size(aT)
    if n > 0
        for i = 0 to n - 1
            if array.get(aT, i) == tOpen
                if (i < n - 1 or barstate.isconfirmed) and not na(array.get(aE, i))
                    found := true
                    sH := array.get(aH, i)
                    sL := array.get(aL, i)
                    sC := array.get(aC, i)
                    sE := array.get(aE, i)
                break

var int   ultimo  = 0
var float pStop   = na
var float pTarget = na

if found and dayKey != ultimo
    ultimo := dayKey
    dir = sC > sE ? 1 : sC < sE ? -1 : 0
    if dir == 1 and tend_ok and strategy.position_size == 0
        stop   = sL * (1.0 - buf_pct / 100.0)
        riesgo = sC - stop
        minimo = sC * min_risk / 100.0
        if riesgo < minimo
            stop   := sC - minimo
            riesgo := minimo
        qty_r = math.floor((strategy.equity * riesgo_p / 100.0) / riesgo)
        qty_c = math.floor(strategy.equity / sC)
        qty   = math.min(qty_r, qty_c)
        if qty >= 1 and riesgo > 0
            pStop   := stop
            pTarget := sC + target_r * riesgo
            strategy.entry('L', strategy.long, qty = qty)

if strategy.position_size > 0 and not na(pStop)
    strategy.exit('X', from_entry = 'L', stop = pStop, limit = pTarget)
    if hour(time, TZ) * 100 + minute(time, TZ) >= hora_fin
        strategy.close_all('fin de dia')

plot(strategy.position_size > 0 ? pStop : na, 'stop', color = color.red, style = plot.style_linebr)
plot(strategy.position_size > 0 ? pTarget : na, 'objetivo', color = color.green, style = plot.style_linebr)
