//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// RAW PRO · el indicador completo (EE. UU. y Xetra)
//
// QUÉ HACE, EN UNA FRASE: mira la primera vela de 5 minutos de la sesión y dice
// si hay compra, dónde está el stop, dónde el objetivo y cuántas acciones comprar.
//
// QUÉ VAS A VER:
//  - Etiqueta LARGO / LARGO filtrado / CORTO / SIN OPERACIÓN en la vela de apertura.
//  - Caja de esa primera vela (el rango que decide todo).
//  - Zona verde: de la entrada al objetivo. Zona roja: de la entrada al stop.
//  - Líneas: SMA50 y SMA200 diarias, máximo/mínimo/cierre de ayer, VWAP.
//  - Panel: estado, entrada, stop, objetivo, tamaño, riesgo y contexto.
//  - Guía de uso arriba, en tres frases.
//
// CÓMO SE USA (para principiante):
//  1. Si la etiqueta dice LARGO, hay compra con plan. Si dice cualquier otra cosa, NO se compra.
//  2. El stop es sagrado: si llega, se sale sin discutir.
//  3. El objetivo es donde se recoge. Si el precio sigue subiendo, se aguanta mientras
//     el cierre diario esté por encima de la SMA50 azul (fila "Salida swing").
//
// Detecta el mercado solo: Europa → 09:00 CET; EE. UU. → 09:30 ET.
// Sin repintar. No envía órdenes. Uso educativo.
// ─────────────────────────────────────────────────────────────────────────────
indicator('RAW PRO · nico66fx', shorttitle = 'RAW PRO', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ── Mercado: automático por la zona horaria del exchange ──
modo     = input.string('Auto', 'Mercado', options = ['Auto', 'EE. UU. (09:30 NY)', 'Xetra (09:00 CET)'])
es_eu    = modo == 'Xetra (09:00 CET)' or (modo == 'Auto' and str.startswith(syminfo.timezone, 'Europe/'))
TZ       = es_eu ? 'Europe/Berlin' : 'America/New_York'
hora     = 9
minuto   = es_eu ? 0 : 30
sym_mercado = es_eu ? 'TVC:DAX' : 'SPY'

// ── Riesgo: lo que decides tú ──
cuenta    = input.float(10000, 'Cuenta', minval = 1, group = 'Riesgo')
riesgo_p  = input.float(1.0, 'Riesgo por operación (%)', minval = 0.05, maxval = 5, step = 0.05, group = 'Riesgo')
target_r  = input.float(2.0, 'Objetivo (R)', minval = 0.5, maxval = 10, step = 0.5, group = 'Riesgo')
target2_r = input.float(4.0, 'Segundo objetivo (R)', minval = 1, maxval = 20, step = 0.5, group = 'Riesgo')
buf_pct   = input.float(0.05, 'Buffer del stop (%)', minval = 0, maxval = 2, step = 0.05, group = 'Riesgo')
min_risk  = input.float(0.20, 'Distancia minima del stop (%)', minval = 0.05, maxval = 2, step = 0.05, group = 'Riesgo')
multiplo  = input.float(1.0, 'Multiplicador (1 acción, 2 MNQ, 20 NQ)', minval = 0.01, group = 'Riesgo')
usar_tend = input.bool(true, 'Solo largos con el diario sobre SMA200', group = 'Riesgo')
usar_mercado = input.bool(false, 'Filtrar por el indice del mercado', group = 'Riesgo')

// ── Estilo: qué quieres ver en el gráfico ──
ver_caja  = input.bool(true, 'Dibujar la vela de las 09:00/09:30', group = 'Estilo')
ver_plan  = input.bool(true, 'Dibujar zonas de beneficio y riesgo', group = 'Estilo')
ver_niveles = input.bool(true, 'Máximo, mínimo y cierre de ayer', group = 'Estilo')
ver_vwap  = input.bool(true, 'VWAP de la sesión', group = 'Estilo')
mostrar_hist = input.bool(false, 'Mostrar historial (señales antiguas)', group = 'Estilo')
ver_contexto = input.bool(true, 'Ver SMA50/SMA200 diarias', group = 'Estilo')
ver_guia  = input.bool(true, 'Ver la guía de uso', group = 'Estilo')
ver_pivotes = input.bool(true, 'Pivotes diarios (PP, R1, S1)', group = 'Estilo')
ver_ema   = input.bool(true, 'EMA20 de 5 minutos', group = 'Estilo')
col_buy   = input.color(#34C759, 'Compra', group = 'Estilo')
col_sell  = input.color(#FF3B30, 'Venta', group = 'Estilo')
col_neu   = input.color(#8E8E93, 'Sin operación', group = 'Estilo')

int  tf_sec = timeframe.in_seconds()
bool low_tf = tf_sec <= 300
bool htf    = not low_tf and tf_sec <= 86400

// Media exponencial de los cierres de 5 minutos (la misma del indicador original)
_k(float x) =>
    var float a = na
    a := na(a) ? x : a + (x - a) * (4.0 / 26.0)
    a

[m5T, m5H, m5L, m5C, m5E] = request.security(syminfo.tickerid, '5', [time, high, low, close, _k(close)], lookahead = barmerge.lookahead_off)
[aT, aH, aL, aC, aE] = request.security_lower_tf(syminfo.tickerid, low_tf ? timeframe.period : '5', [time, high, low, close, _k(close)])

// ── Contexto diario: siempre el dato del día anterior, sin mirar el futuro ──
dC    = request.security(syminfo.tickerid, 'D', close[1], lookahead = barmerge.lookahead_off)
dH    = request.security(syminfo.tickerid, 'D', high[1], lookahead = barmerge.lookahead_off)
dL    = request.security(syminfo.tickerid, 'D', low[1], lookahead = barmerge.lookahead_off)
dS50  = request.security(syminfo.tickerid, 'D', ta.sma(close, 50)[1], lookahead = barmerge.lookahead_off)
dS200 = request.security(syminfo.tickerid, 'D', ta.sma(close, 200)[1], lookahead = barmerge.lookahead_off)
dRsi  = request.security(syminfo.tickerid, 'D', ta.rsi(close, 14)[1], lookahead = barmerge.lookahead_off)
dAtr  = request.security(syminfo.tickerid, 'D', ta.atr(14)[1], lookahead = barmerge.lookahead_off)
dAtrA = request.security(syminfo.tickerid, 'D', ta.sma(ta.atr(14), 100)[1], lookahead = barmerge.lookahead_off)
dHi   = request.security(syminfo.tickerid, 'D', ta.highest(high, 252)[1], lookahead = barmerge.lookahead_off)
dAdr  = request.security(syminfo.tickerid, 'D', ta.sma(high - low, 14)[1], lookahead = barmerge.lookahead_off)
mC    = request.security(sym_mercado, 'D', close[1], lookahead = barmerge.lookahead_off)
mS    = request.security(sym_mercado, 'D', ta.sma(close, 200)[1], lookahead = barmerge.lookahead_off)
merc_ok = not usar_mercado or na(mS) or mC > mS

tend_ok  = (not usar_tend or na(dS200) or dC > dS200) and merc_ok
ctx      = na(dS200) ? 'SIN DATOS' : dC > dS200 and dS50 > dS200 ? 'A FAVOR' : dC < dS200 ? 'EN CONTRA' : 'NEUTRO'
atr_pct  = na(dAtr) or na(dC) ? na : dAtr / dC * 100
compres  = not na(dAtrA) and not na(dAtr) and dAtr < dAtrA * 0.7
dist_max = na(dHi) or dHi == 0 ? na : (dC / dHi - 1.0) * 100.0
adr_pct  = na(dAdr) or na(dC) or dC == 0 ? na : dAdr / dC * 100.0
pp = (dH + dL + dC) / 3.0
r1 = 2.0 * pp - dL
s1 = 2.0 * pp - dH

// ── Momento de la primera vela de la sesión ──
openTime(int t) => timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), hora, minuto)
keyOf(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
int todayKey = keyOf(timenow)

int c1   = openTime(time)
int c2   = openTime(time_close)
int tBar = c1 >= time and c1 < time_close ? c1 : c2 >= time and c2 < time_close ? c2 : na
int tOpen  = low_tf ? c1 : tBar
int tOpen5 = na(tOpen) ? na : tOpen + 5 * 60 * 1000
int dayKey = na(tOpen) ? 0 : keyOf(tOpen)

// ── Detección de la primera vela ──
bool  found = false
float sH = na
float sL = na
float sC = na
float sE = na
if low_tf
    if barstate.isconfirmed and not na(m5E) and m5T == tOpen and time_close == tOpen5
        found := true
        sH := m5H
        sL := m5L
        sC := m5C
        sE := m5E
else if htf and not na(tOpen)
    n = array.size(aT)
    if n > 0
        for i = 0 to n - 1
            if array.get(aT, i) == tOpen
                if (i < n - 1 or barstate.isconfirmed) and not na(array.get(aE, i))
                    found := true
                    sH := array.get(aH, i)
                    sL := array.get(aL, i)
                    sC := array.get(aC, i)
                    sE := array.get(aE, i)
                break

// ── Plan del día ──
var int    ultimo  = 0
var int    dir     = 0
var float  pEntry  = na
var float  pStop   = na
var float  pTarget = na
var float  pTarget2 = na
var float  pQty    = na
var float  pRisk   = na
var string pEstado = 'Esperando'

if found and dayKey != ultimo
    ultimo  := dayKey
    dir     := sC > sE ? 1 : sC < sE ? -1 : 0
    pEntry  := sC
    pStop   := na
    pTarget := na
    pTarget2 := na
    pQty    := na
    pRisk   := na
    pEstado := dir == 1 ? (tend_ok ? 'LARGO' : 'LARGO filtrado') : dir == -1 ? 'CORTO (no operable)' : 'SIN OPERACIÓN'
    if dir == 1 and tend_ok
        stop   = sL * (1.0 - buf_pct / 100.0)
        riesgo = sC - stop
        minimo = sC * min_risk / 100.0
        if riesgo < minimo
            stop   := sC - minimo
            riesgo := minimo
        if riesgo > 0
            pStop   := stop
            pRisk   := riesgo
            pTarget := sC + target_r * riesgo
            pTarget2 := sC + target2_r * riesgo
            qty_r   = math.floor((cuenta * riesgo_p / 100.0) / (riesgo * multiplo))
            qty_c   = math.floor(cuenta / (sC * multiplo))
            pQty    := math.min(qty_r, qty_c)

    visible = mostrar_hist or dayKey == todayKey

    if ver_caja and visible
        c = dir == 1 ? col_buy : dir == -1 ? col_sell : col_neu
        box.new(tOpen, sH, tOpen5, sL, xloc = xloc.bar_time, border_color = color.new(c, 20), bgcolor = color.new(c, 88))

    if visible
        c_est = pEstado == 'LARGO' ? col_buy : pEstado == 'CORTO (no operable)' ? col_sell : col_neu
        etiqueta = pEstado + (na(pStop) ? '' : '  |  E ' + str.tostring(pEntry, '#.##') + '   S ' + str.tostring(pStop, '#.##') + '   O ' + str.tostring(pTarget, '#.##') + '   O2 ' + str.tostring(pTarget2, '#.##') + '   x' + str.tostring(pQty, '0'))
        label.new(bar_index, sH, etiqueta, style = label.style_label_down, color = c_est, textcolor = color.white, size = size.small)

    if visible and dir == 1 and tend_ok and not na(pStop)
        line.new(tOpen5, pStop, tOpen5 + 45 * 60 * 1000, pStop, xloc = xloc.bar_time, color = col_sell, width = 1)
        line.new(tOpen5, pTarget, tOpen5 + 45 * 60 * 1000, pTarget, xloc = xloc.bar_time, color = col_buy, width = 1)
        line.new(tOpen5, pTarget2, tOpen5 + 45 * 60 * 1000, pTarget2, xloc = xloc.bar_time, color = color.new(col_buy, 50), style = line.style_dashed, width = 1)

    if ver_plan and dayKey == todayKey and dir == 1 and tend_ok and not na(pStop)
        box.new(tOpen5, pTarget, tOpen5 + 45 * 60 * 1000, pEntry, xloc = xloc.bar_time, border_color = color.new(col_buy, 60), bgcolor = color.new(col_buy, 88))
        box.new(tOpen5, pEntry, tOpen5 + 45 * 60 * 1000, pStop, xloc = xloc.bar_time, border_color = color.new(col_sell, 60), bgcolor = color.new(col_sell, 88))

    alert('RAW PRO ' + syminfo.ticker + ' ' + pEstado + (na(pStop) ? '' : ' | entrada ' + str.tostring(pEntry, '#.##') + ' stop ' + str.tostring(pStop, '#.##') + ' objetivo ' + str.tostring(pTarget, '#.##') + ' tamano ' + str.tostring(pQty, '0') + ' | contexto ' + ctx), alert.freq_once_per_bar)

// ── Aviso si aún no hay primera vela ──
var label espera = na
if barstate.islast
    if ultimo != todayKey
        if na(espera)
            espera := label.new(bar_index, high, 'Esperando primera vela · ' + (es_eu ? '09:00' : '09:30'), style = label.style_label_down, color = col_neu, textcolor = color.white, size = size.small)
    else if not na(espera)
        label.delete(espera)
        espera := na

// ── Panel de datos ──
var table tb = table.new(position.bottom_right, 2, 17, frame_width = 1, border_width = 4)

if barstate.islast
    table.cell(tb, 0, 0, 'RAW PRO · ' + (es_eu ? 'Xetra' : 'EE. UU.'), text_size = size.small)
    table.cell(tb, 1, 0, pEstado, text_size = size.small, text_color = pEstado == 'LARGO' ? col_buy : pEstado == 'CORTO (no operable)' ? col_sell : col_neu)
    table.cell(tb, 0, 1, 'Entrada')
    table.cell(tb, 1, 1, na(pEntry) ? '-' : str.tostring(pEntry, '#.##'))
    table.cell(tb, 0, 2, 'Stop')
    table.cell(tb, 1, 2, na(pStop) ? '-' : str.tostring(pStop, '#.##'))
    table.cell(tb, 0, 3, 'Objetivo')
    table.cell(tb, 1, 3, na(pTarget) ? '-' : str.tostring(pTarget, '#.##'))
    table.cell(tb, 0, 4, 'Tamaño')
    table.cell(tb, 1, 4, na(pQty) ? '-' : str.tostring(pQty, '0'))
    table.cell(tb, 0, 5, 'Riesgo')
    table.cell(tb, 1, 5, na(pQty) or na(pRisk) ? '-' : str.tostring(pQty * pRisk * multiplo, '#.##'))
    table.cell(tb, 0, 6, 'Tendencia diaria')
    table.cell(tb, 1, 6, ctx, text_color = ctx == 'A FAVOR' ? col_buy : ctx == 'EN CONTRA' ? col_sell : col_neu)
    table.cell(tb, 0, 7, 'RSI diario')
    table.cell(tb, 1, 7, na(dRsi) ? '-' : str.tostring(dRsi, '#.#'))
    table.cell(tb, 0, 8, 'ATR diario %')
    table.cell(tb, 1, 8, na(atr_pct) ? '-' : str.tostring(atr_pct, '#.##') + ' %')
    table.cell(tb, 0, 9, 'Dist. maximo 52s')
    table.cell(tb, 1, 9, na(dist_max) ? '-' : str.tostring(dist_max, '#.#') + ' %')
    table.cell(tb, 0, 10, 'Compresión')
    table.cell(tb, 1, 10, compres ? 'SÍ (posible giro)' : 'no')
    table.cell(tb, 0, 11, 'Salida swing')
    table.cell(tb, 1, 11, 'cierre diario < SMA50')
    table.cell(tb, 0, 12, 'Mercado')
    table.cell(tb, 1, 12, merc_ok ? 'OK' : 'filtrado', text_color = merc_ok ? col_buy : col_sell)
    table.cell(tb, 0, 13, 'Comprar')
    table.cell(tb, 1, 13, 'solo si dice LARGO', text_color = col_neu)
    table.cell(tb, 0, 14, 'Vender')
    table.cell(tb, 1, 14, 'en stop u objetivo', text_color = col_neu)
    table.cell(tb, 0, 15, 'Objetivo 2')
    table.cell(tb, 1, 15, na(pTarget2) ? '-' : str.tostring(pTarget2, '#.##'))
    table.cell(tb, 0, 16, 'Recorrido medio %')
    table.cell(tb, 1, 16, na(adr_pct) ? '-' : str.tostring(adr_pct, '#.##') + ' %')

// ── Guía de uso, arriba ──
var table guia = table.new(position.top_center, 1, 4, frame_width = 1, border_width = 4)

if barstate.islast and ver_guia
    table.cell(guia, 0, 0, 'CÓMO USARLO', text_size = size.small)
    table.cell(guia, 0, 1, '1. Etiqueta LARGO: comprar', text_size = size.tiny)
    table.cell(guia, 0, 2, '2. Stop: salir sin discutir', text_size = size.tiny)
    table.cell(guia, 0, 3, '3. Objetivo: vender', text_size = size.tiny)

// ── Líneas de contexto ──
plot(ver_contexto ? dS50 : na, 'SMA50 diaria', color = color.new(color.blue, 30), style = plot.style_linebr)
plot(ver_contexto ? dS200 : na, 'SMA200 diaria', color = color.new(color.gray, 20), style = plot.style_linebr)
plot(ver_niveles ? dH : na, 'Máximo de ayer', color = color.new(color.orange, 40), style = plot.style_linebr)
plot(ver_niveles ? dL : na, 'Mínimo de ayer', color = color.new(color.orange, 40), style = plot.style_linebr)
plot(ver_niveles ? dC : na, 'Cierre de ayer', color = color.new(color.gray, 50), style = plot.style_linebr)
plot(ver_vwap ? ta.vwap(hlc3) : na, 'VWAP', color = color.new(color.purple, 30), style = plot.style_linebr)
plot(ver_ema ? ta.ema(close, 20) : na, 'EMA20', color = color.new(color.teal, 20), style = plot.style_linebr)
plot(ver_pivotes ? pp : na, 'Pivote', color = color.new(color.yellow, 20), style = plot.style_linebr)
plot(ver_pivotes ? r1 : na, 'R1', color = color.new(color.yellow, 60), style = plot.style_linebr)
plot(ver_pivotes ? s1 : na, 'S1', color = color.new(color.yellow, 60), style = plot.style_linebr)

alertcondition(found and dir == 1 and tend_ok, 'COMPRA PRO', 'RAW PRO: plan largo en {{exchange}}:{{ticker}}')
alertcondition(found and dir == -1, 'VENTA PRO', 'RAW PRO: sesgo corto en {{exchange}}:{{ticker}} (no operable en solo largo)')
