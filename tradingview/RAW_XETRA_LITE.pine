//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// RAW XETRA LITE · adaptación de "nico66fx | RAW NASDAQ LITE" (autor original: nico66fx)
// Marca la primera vela de 5 minutos de Xetra (09:00-09:05, hora de Berlín/Madrid)
// y dice COMPRA o VENTA. Sin repintar, una vez al día.
// No calcula stops ni contratos y no envía órdenes. Uso educativo.
// ─────────────────────────────────────────────────────────────────────────────
indicator('RAW XETRA LITE · nico66fx', shorttitle = 'RAW XETRA LITE', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

const string TZ = 'Europe/Berlin'

var string g1 = 'Vela de las 09:00'
var string g2 = 'Estilo'
var string g3 = 'Paneles'

show_history   = input.bool(true, 'Días anteriores', group = g1)
show_levels    = input.bool(true, 'Máximo y mínimo de la vela', group = g1)
levels_minutes = input.int(45, 'Duración de los niveles (min)', minval = 0, maxval = 390, group = g1)

col_buy        = input.color(#34C759, 'Compra', group = g2)
col_sell       = input.color(#FF3B30, 'Venta', group = g2)
col_accent     = input.color(#0A84FF, 'Acento', group = g2)

show_panel     = input.bool(true, 'Estado (arriba al centro)', group = g3)

// ── Tema: se adapta solo al fondo claro u oscuro del gráfico ──
lum(color c) => (0.2126 * color.r(c) + 0.7152 * color.g(c) + 0.0722 * color.b(c)) / 255.0

dark      = lum(chart.bg_color) < 0.5
c_card    = dark ? #1C1C1E : #FFFFFF
c_hair    = dark ? #38383A : #E5E5EA
c_text    = dark ? #F5F5F7 : #1D1D1F
c_sub     = dark ? #98989D : #86868B
c_level   = dark ? #48484A : #C7C7CC

// ── Datos de 5 minutos ──
int  tf_sec = timeframe.in_seconds()
bool low_tf = tf_sec <= 300
bool htf    = not low_tf and tf_sec <= 86400

_k(float x) =>
    var float _a = na
    _a := na(_a) ? x : _a + (x - _a) * (4.0 / 26.0)
    _a

[m5T, m5H, m5L, m5C, m5E] = request.security(syminfo.tickerid, '5', [time, high, low, close, _k(close)], lookahead = barmerge.lookahead_off)
[aT, aH, aL, aC, aE] = request.security_lower_tf(syminfo.tickerid, low_tf ? timeframe.period : '5', [time, high, low, close, _k(close)])

// 09:00 en hora de Berlín (misma hora que Madrid todo el año)
openTime(int t) => timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 9, 0)
keyOf(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

int todayKey = keyOf(timenow)
int c1   = openTime(time)
int c2   = openTime(time_close)
int tBar = c1 >= time and c1 < time_close ? c1 : c2 >= time and c2 < time_close ? c2 : na
int tOpen   = low_tf ? c1 : tBar
int tOpen5  = na(tOpen) ? na : tOpen + 5 * 60 * 1000
int dayKey  = na(tOpen) ? 0 : keyOf(tOpen)

in_candle = tf_sec < 86400 and not na(tOpen) and (low_tf ? time >= tOpen and time < tOpen5 : true) and (show_history or dayKey == todayKey)
bgcolor(in_candle ? color.new(col_accent, 92) : na, title = 'Vela de 09:00')

// ── Motor (sin repintar: solo con la vela de 09:00-09:05 ya cerrada) ──
bool  found = false
float sH = na
float sL = na
float sC = na
float sE = na
if low_tf
    if barstate.isconfirmed and not na(m5E) and m5T == tOpen and time_close == tOpen5
        found := true
        sH := m5H
        sL := m5L
        sC := m5C
        sE := m5E
else if htf and not na(tOpen)
    n = array.size(aT)
    if n > 0
        for i = 0 to n - 1
            if array.get(aT, i) == tOpen
                if (i < n - 1 or barstate.isconfirmed) and not na(array.get(aE, i))
                    found := true
                    sH := array.get(aH, i)
                    sL := array.get(aL, i)
                    sC := array.get(aC, i)
                    sE := array.get(aE, i)
                break

var int ultimo_dia = 0
bool nueva = found and dayKey != ultimo_dia
int dir_ahora = sC > sE ? 1 : sC < sE ? -1 : 0

var int s_dir = 0
if nueva
    ultimo_dia := dayKey
    s_dir := dir_ahora
    if show_history or barstate.isrealtime or dayKey == todayKey
        c_dir = s_dir == 1 ? col_buy : s_dir == -1 ? col_sell : c_sub
        t_l   = low_tf ? tOpen : time
        t_r   = low_tf ? tOpen5 : time_close
        t_mid = int(math.avg(t_l, t_r))
        t_end = t_r + math.max(levels_minutes * 60 * 1000, low_tf ? 0 : 3 * tf_sec * 1000)

        box.new(t_l, sH, t_r, sL, xloc = xloc.bar_time, border_color = color.new(c_dir, 92), border_width = 14, bgcolor = na)
        box.new(t_l, sH, t_r, sL, xloc = xloc.bar_time, border_color = color.new(c_dir, 84), border_width = 8, bgcolor = na)
        box.new(t_l, sH, t_r, sL, xloc = xloc.bar_time, border_color = color.new(c_dir, 68), border_width = 4, bgcolor = na)
        box.new(t_l, sH, t_r, sL, xloc = xloc.bar_time, border_color = color.new(c_dir, 20), border_width = 1, bgcolor = color.new(c_dir, 86))

        if show_levels and levels_minutes > 0 and tf_sec < 14400
            line.new(t_r, sH, t_end, sH, xloc = xloc.bar_time, extend.none, c_level, line.style_solid, 1)
            line.new(t_r, sL, t_end, sL, xloc = xloc.bar_time, extend.none, c_level, line.style_solid, 1)

        if tf_sec < 14400
            label.new(t_mid, s_dir == -1 ? sL : sH, '09:00', xloc = xloc.bar_time, color = color.new(c_card, 100), style = s_dir == -1 ? label.style_label_up : label.style_label_down, textcolor = c_sub, size = size.small)

        txt = tf_sec >= 14400 ? (s_dir == 1 ? '↑' : s_dir == -1 ? '↓' : '·') : s_dir == 1 ? '↑  COMPRA' : s_dir == -1 ? '↓  VENTA' : 'SIN OPERACIÓN'
        label.new(time, s_dir == -1 ? math.max(sH, high) : math.min(sL, low), txt, xloc = xloc.bar_time, color = c_dir, style = s_dir == -1 ? label.style_label_down : label.style_label_up, textcolor = #FFFFFF, size = tf_sec >= 14400 ? size.small : size.normal)

    alert('1ª vela de Xetra: ' + (s_dir == 1 ? 'COMPRA' : s_dir == -1 ? 'VENTA' : 'hoy no se opera'), alert.freq_once_per_bar)

// ── Panel tipo tarjeta ──
var table tb = table.new(position.top_center, 1, 3, frame_width = 1, border_width = 6)
var table wm = table.new(position.bottom_right, 1, 1)

if barstate.islast
    table.cell(wm, 0, 0, 'RAW XETRA LITE · nico66fx', text_color = color.new(c_sub, 50), text_size = size.small)

    if show_panel
        table.set_bgcolor(tb, c_card)
        table.set_frame_color(tb, c_hair)
        table.set_border_color(tb, c_card)
        hoy    = ultimo_dia == todayKey
        faltan = 9 * 60 + 5 - (hour(timenow, TZ) * 60 + minute(timenow, TZ))
        estado = hoy ? (s_dir == 1 ? '↑  COMPRA' : s_dir == -1 ? '↓  VENTA' : 'Hoy no se opera') : faltan > 0 and faltan < 600 ? str.format('Faltan {0} min', faltan) : 'Esperando a las 09:05'
        c_est  = hoy ? (s_dir == 1 ? col_buy : s_dir == -1 ? col_sell : c_sub) : c_text
        table.cell(tb, 0, 0, 'Primera vela de Xetra', text_color = c_sub, text_size = size.small)
        table.cell(tb, 0, 1, estado, text_color = c_est, text_size = size.large)
        table.cell(tb, 0, 2, 'Xetra  ·  09:00 CET  ·  09:00 España', text_color = c_sub, text_size = size.tiny)

alertcondition(nueva and dir_ahora == 1, 'COMPRA', '1ª vela de Xetra: COMPRA en {{exchange}}:{{ticker}}')
alertcondition(nueva and dir_ahora == -1, 'VENTA', '1ª vela de Xetra: VENTA en {{exchange}}:{{ticker}}')
